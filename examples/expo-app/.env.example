# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* values into the app.
# Your server URL. On a real phone "localhost" is the phone itself: use your computer's LAN IP,
# e.g. http://192.168.1.20:8000 (if left empty the app guesses your computer's address from Expo).
EXPO_PUBLIC_TRUVAXIA_BASE_URL=
# Organization API key. In production do NOT ship this in the app: have YOUR server call
# POST /api/v1/sessions/initiate and return only the verification URL to the app.
EXPO_PUBLIC_TRUVAXIA_API_KEY=your_org_api_key
